# Pin the Raspberry Pi kernel to 6.18.39.
#
# Pinned for reproducible builds: stage0/00-configure-apt runs `apt-get
# dist-upgrade -y` and later stages install/upgrade packages, so an unpinned
# kernel floats to whatever is latest at build time. That is how v0.2.6 shipped
# 6.18.34, which broke BLE advertising (fixed upstream in 6.18.36, verified on
# hardware with 6.18.39). Pin-Priority 1001 > 1000 also allows a downgrade if a
# newer one already slipped in.
Package: linux-image-* linux-headers-* linux-kbuild-*
Pin: version 1:6.18.39-1+rpt1
Pin-Priority: 1001
